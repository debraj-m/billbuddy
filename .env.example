# Canonical site URL, used for sitemap, canonical links and Open Graph.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL if left empty.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console verification: the content="" value of the HTML tag method.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Public contact address shown on /contact and /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
